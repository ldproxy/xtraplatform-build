{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["ldproxy/renovate-config:xtraplatform", "ldproxy/renovate-config:maintenance(6.1)"],
  "packageRules": [
     {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "groupName": "testing",
      "matchPackageNames": ["/spock/", "/groovy/", "/byte-buddy/", "/objenesis/"]
    },
    {
      "groupName": "annotations",
      "matchPackageNames": ["/dagger/", "/immutables/"],
      "automerge": false
    },
    {
      "groupName": "quality",
      "matchPackageNames": ["/pmd/"]
    },
    {
      "groupName": "plugins",
      "matchFileNames": ["gradle/plugins.versions.toml"]
    },
    {
      "groupName": "plugins-internal",
      "matchFileNames": ["gradle/plugins.versions.toml"],
      "matchPackageNames": ["/gson/", "/guava/", "/osdetector/"],
      "labels": ["build-dependencies"]
    },
    {
      "description": "???",
      "matchPackageNames": ["/org.immutables/"],
      "allowedVersions": "< 2.12.0"
    },
    {
      "description": "See https://github.com/CycloneDX/cyclonedx-gradle-plugin/issues/821",
      "matchPackageNames": ["/cyclonedx-gradle-plugin/"],
      "allowedVersions": "< 3.2.3"
    }
  ]
}
